# ============================================================================
# TEMPLAT PEMBOLEHUBAH PERSEKITARAN (ENVIRONMENT VARIABLES TEMPLATE)
# AMARAN KESELAMATAN: JANGAN sesekali letakkan API Key sebenar di dalam fail ini!
# Fail .env.example ini akan dimuat naik ke GitHub sebagai rujukan struktur sahaja.
# Untuk kegunaan komputer sendiri, salin fail ini kepada `.env` atau `.env.local`
# (Fail `.env` telah dilindungi oleh `.gitignore` dan tidak akan naik ke GitHub).
# ============================================================================

# Google Gemini API Key (Tetapkan nilai sebenar di Vercel Environment Variables / .env)
GEMINI_API_KEY=

# Kunci Sandaran Tambahan (Pilihan - Untuk kitaran kuota / Key Rotation)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Integrasi Bot Telegram (Pilihan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
